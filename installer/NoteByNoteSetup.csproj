<Project Sdk="Microsoft.NET.Sdk">
  <!-- Note-by-Note Setup: installs / uninstalls the mod in the Rocksmith 2014 folder.
       .NET Framework 4.8 (comes with Windows 10/11), so the player doesn't need to install anything.
       The files it installs are embedded in the exe ("payload/<name>"); build it with package.ps1,
       which stages them in PayloadDir first. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>NoteByNoteSetup</AssemblyName>
    <RootNamespace>NoteByNoteSetup</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version Condition="'$(Version)' == ''">0.0.0</Version>
    <Product>Note-by-Note for Rocksmith 2014</Product>
    <Description>Note-by-Note for Rocksmith 2014 - Setup</Description>
    <PayloadDir Condition="'$(PayloadDir)' == ''">$(MSBuildThisFileDirectory)..\dist\payload</PayloadDir>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(PayloadDir)\*" LogicalName="payload/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
