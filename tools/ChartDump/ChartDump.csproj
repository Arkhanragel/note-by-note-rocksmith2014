<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ChartDump: reads a Rocksmith 2014 .psarc and exports the notes of an arrangement to JSON.
    It uses the Rocksmith2014.NET library (F#), which is included as a git submodule in external/.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\external\Rocksmith2014.NET\src\Rocksmith2014.PSARC\Rocksmith2014.PSARC.fsproj" />
    <ProjectReference Include="..\..\external\Rocksmith2014.NET\src\Rocksmith2014.SNG\Rocksmith2014.SNG.fsproj" />
  </ItemGroup>

</Project>
